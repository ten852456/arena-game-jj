# Copy to .env (never commit it) or set these in Railway → Variables. Every one is optional.
PORT=8787                 # the server's port (Railway sets it)
DATA_DIR=./data           # where db.json, site.json and events/ are written (Railway: the volume at /app/data)
ADMIN_TOKEN=              # 16+ characters; opens /admin. Without it /admin answers 503
SEASON=s1                 # the season id written on runs and towns
SAVE_EVERY_MS=2000        # the database file is written at most this often (and on SIGTERM)
# town playtest switches (never on live)
FARM_TIME_SCALE=1         # 1 = real time; 3600 = one hour per second
FARM_GATE=on              # "off" = no hero lock or run limit
# FARM_LAUNCH=            # ms timestamp; towns before it are grandfathered
# Railway only
# RAILWAY_RUN_UID=0       # volumes belong to root; the image runs as node
