{
  "name": "arena-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "balance": "tsx scripts/balance.ts",
    "test": "tsx scripts/determinism.ts && tsx scripts/damage-kind.ts && tsx scripts/i18n-check.ts",
    "smoke": "tsx scripts/smoke.ts",
    "security": "tsx scripts/security-check.ts",
    "runs": "tsx scripts/runs.ts",
    "sim": "tsx scripts/sim.ts",
    "exploit": "tsx scripts/exploit.ts",
    "explain": "tsx scripts/explain-check.ts",
    "tune": "tsx scripts/tune.ts",
    "i18n": "tsx scripts/i18n-check.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "buffer": "^6.0.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
