{
  "name": "mochi-moon",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "balance": "tsx tools/balance.ts",
    "test": "tsx tests/determinism.ts && tsx tests/i18n-check.ts && tsx tests/skilltext-check.ts && tsx tests/upgrade-check.ts && tsx tests/validate-check.ts && tsx tests/fight-check.ts && tsx tests/farm-check.ts && tsx tests/vault-check.ts && tsx tests/damage-kind.ts",
    "smoke": "tsx tests/smoke.ts",
    "security": "tsx tests/security-check.ts",
    "farm-api": "tsx tests/farm-api-check.ts",
    "farm-sim": "tsx tools/farm-sim.ts",
    "bench": "tsx tools/bench-server.ts",
    "runs": "tsx tools/runs.ts",
    "sim": "tsx tools/sim.ts",
    "exploit": "tsx tools/exploit.ts",
    "explain": "tsx tests/explain-check.ts",
    "tune": "tsx tools/tune.ts",
    "i18n": "tsx tests/i18n-check.ts",
    "facts": "tsx tools/facts.ts",
    "ts-to-rust": "tsx tools/ts-to-rust.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^4.0.1",
    "buffer": "^6.0.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
