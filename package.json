{
  "name": "arena-poc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "balance": "tsx scripts/balance.ts",
    "test": "tsx scripts/determinism.ts && tsx scripts/i18n-check.ts && tsx scripts/skilltext-check.ts && tsx scripts/upgrade-check.ts && tsx scripts/validate-check.ts && tsx scripts/fight-check.ts && tsx scripts/farm-check.ts && tsx scripts/damage-kind.ts",
    "smoke": "tsx scripts/smoke.ts",
    "security": "tsx scripts/security-check.ts",
    "farm-api": "tsx scripts/farm-api-check.ts",
    "farm-sim": "tsx scripts/farm-sim.ts",
    "bench": "tsx scripts/bench-server.ts",
    "runs": "tsx scripts/runs.ts",
    "sim": "tsx scripts/sim.ts",
    "exploit": "tsx scripts/exploit.ts",
    "explain": "tsx scripts/explain-check.ts",
    "tune": "tsx scripts/tune.ts",
    "i18n": "tsx scripts/i18n-check.ts",
    "facts": "tsx scripts/facts.ts",
    "ts-to-rust": "tsx scripts/ts-to-rust.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^4.0.1",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
